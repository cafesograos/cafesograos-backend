# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# URL do site publicado (usada para redirecionar o cliente após o pagamento)
SITE_URL=https://www.cafesograos.com.br

# Porta local (o host de produção geralmente define isso sozinho)
PORT=3000
