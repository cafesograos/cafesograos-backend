# Copie este arquivo para ".env" e preencha com suas credenciais reais.

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# URL do site publicado (usada para redirecionar o cliente após o pagamento)
SITE_URL=https://www.cafesograos.com.br

# Porta local (o host de produção geralmente define isso sozinho)
PORT=3000

# Postgres — em produção o Railway injeta isso automaticamente via
# variável de referência (${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Senha de acesso ao painel /admin/pedidos (?senha=...)
ADMIN_PASSWORD=escolha_uma_senha_forte

# Melhor Envio (cálculo de frete) — https://melhorenvio.com.br (painel de apps)
# Depois de configurar, autorize uma vez em /oauth/melhorenvio/connect
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=

# Resend (e-mail de novo pedido) — https://resend.com/api-keys
RESEND_API_KEY=
# Até o domínio cafesograos.com.br ser verificado no Resend, use o remetente
# padrão deles (onboarding@resend.dev) — só entrega pro e-mail da própria conta Resend.
RESEND_FROM_EMAIL=Café Só Grãos <onboarding@resend.dev>
NOTIFY_EMAIL=alberto.adm@cafesograos.com
